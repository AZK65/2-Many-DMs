{
  "expo": {
    "name": "Omni CRM",
    "slug": "omni-crm-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon-ios-v2.png",
    "scheme": "omni-crm",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.twomanydms.mobile",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to protect your private Omni CRM workspace.",
        "NSPhotoLibraryUsageDescription": "Choose photos and videos to send in your CRM conversations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Use Face ID to protect your private Omni CRM workspace."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to protect your private Omni CRM workspace."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos to send in your CRM conversations.",
          "cameraPermission": "Take photos to send in your CRM conversations.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ]
  }
}
