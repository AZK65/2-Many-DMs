DATABASE_URL="file:./dev.db"

# --- Telegram (GramJS / MTProto) ---
# Get api_id + api_hash from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Filled in by `npm run tg:login` (one-time phone login).
TELEGRAM_SESSION=

# --- WhatsApp ---
WHATSAPP_ENABLED=
# Driver: "baileys" = browser-free WebSocket (~20-40MB/account, best for
# multi-account); blank/"web" = whatsapp-web.js + Chromium (~400MB).
WHATSAPP_DRIVER=baileys
# Optional: pin a known-good web build if linking fails. Newest filename from
# https://github.com/wppconnect-team/wa-version/tree/main/html (without .html)
WHATSAPP_WEB_VERSION=
# How many of your most-recent WhatsApp DMs to import on first link.
WHATSAPP_BACKFILL_CHATS=20

# --- X / Twitter ---
X_ENABLED=
# Driver: "browser" = Puppeteer XChat (encrypted/current DMs, recommended);
# "api" = browser-free but only reads legacy classic DMs. Both use
# X_AUTH_TOKEN/X_CT0.
X_DRIVER=browser
X_POLL_MS=60000
X_AUTO_REPAIR_PACE_MS=60000
X_HISTORY_PACE_MS=60000
X_BACKFILL_PACE_MS=60000
# The inbox page remains mounted; scans read its local DOM and do not reload X.
# Only conversations whose stable message preview changed are opened.
X_LIVE_CHATS=2
# Keep startup light; use a chat's Backfill button for older history.
X_STARTUP_CHATS=2
X_BACKFILL_CHATS=20
# Extra inbox viewports collected only during startup history discovery.
X_INBOX_SCROLLS=0
# A single safety refresh covers identical consecutive previews without polling
# every chat. Load errors recover slowly; real HTTP 429s open a persisted
# exponential circuit breaker that survives process restarts.
X_SAFETY_REFRESH_MS=1800000
X_INBOX_RECOVERY_MS=600000
X_RATE_LIMIT_BASE_MS=900000
# Repeated history scrolling is used only by the manual Backfill button.
X_HISTORY_SCROLLS=8
# Bypass X login bot-detection: paste auth_token + ct0 cookies from your browser
# (DevTools -> Application -> Cookies -> https://x.com), or use the Chrome extension.
X_AUTH_TOKEN=
X_CT0=
X_CHROME_CHANNEL=
# XChat (encrypted DMs) passcode — unlocks decryption keys in the browser.
# REQUIRED on a headless self-hosted box: with no screen to type into, the worker
# enters this itself when it hits the passcode gate. On a machine with a display
# you can leave it blank and use `npm run x:unlock` instead.
# A rejected passcode is NOT retried (repeat attempts trip X's recovery lockout)
# — fix it here and restart the worker.
X_PASSCODE=

# --- Discord ---
# Official bots only. Create an app at https://discord.com/developers/applications,
# add a Bot, enable Message Content Intent, and invite it with View Channels,
# Read Message History, Send Messages, Attach Files, and Send in Threads.
# You can paste the token securely in Connections instead of keeping it here.
DISCORD_ENABLED=
DISCORD_BOT_TOKEN=
# Optional comma-separated channel allowlist. Blank means every channel the bot
# has permission to view. Initial import limits keep first sync manageable.
DISCORD_CHANNEL_IDS=
DISCORD_BACKFILL_CHATS=40
DISCORD_BACKFILL_MESSAGES=25
DISCORD_BACKFILL_DAYS=14

# --- Gmail ---
# Enable the Gmail API in Google Cloud, create a Web application OAuth client,
# and add http://localhost:3000/api/accounts/gmail/callback as an authorized
# redirect URI (use your WEB_URL domain instead when hosted).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public app origin used to construct the OAuth callback URL.
WEB_URL=http://localhost:3000
# --- Private local translation ---
# Runs through Ollama on this machine. No OpenAI key or cloud translation API.
# Install the configured local models with: npm run setup:models
# Check installed files with: npm run models:check
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TRANSLATION_MODEL=translategemma:4b
OLLAMA_TRANSLATION_TIMEOUT_MS=90000
# Reply drafting also stays local. It uses the translation model by default;
# set a different installed Ollama chat model here when you want to.
OLLAMA_REPLY_MODEL=
OLLAMA_REPLY_TIMEOUT_MS=90000
OLLAMA_AUTOCORRECT_MODEL=qwen3.5:4b
OLLAMA_AUTOCORRECT_TIMEOUT_MS=45000
# Image OCR also stays local. Install once with: ollama pull glm-ocr:latest
# Set OCR_ENABLED=0 to disable background image indexing.
OCR_ENABLED=1
OLLAMA_OCR_MODEL=glm-ocr:latest
# On-demand photo translation reads the full photo with a local vision model.
# Install once: ollama pull qwen3.5:4b (also used by default autocorrect).
OLLAMA_PHOTO_OCR_MODEL=qwen3.5:4b
OLLAMA_OCR_TIMEOUT_MS=180000
OCR_MAX_MB=20
OCR_MAX_TOKENS=512
# Normal mode indexes only images received after OCR was enabled. Set this to 1
# temporarily for an intentional historical backfill.
OCR_INCLUDE_HISTORY=0
# Unload the vision model after every image so it does not keep the Mac hot.
OCR_KEEP_ALIVE=0s
# One live image per minute keeps chat syncing responsive.
OCR_INTERVAL_MS=60000
# Automatic sync stays conservative; a user-requested video recovery can fetch
# a larger file without making every chat download large media in the background.
MEDIA_MAX_MB=25
MEDIA_RECOVERY_MAX_MB=250

# --- Sync worker ---
SYNC_CONTROL_PORT=4001
SYNC_CONTROL_URL=http://localhost:4001
SYNC_BACKFILL=1
# Keep startup light so live messages and sends have priority. Set to 1 only
# when you intentionally want every worker start to deep-import recent chats.
SYNC_STARTUP_DEEP_BACKFILL=0
SYNC_BACKFILL_DIALOGS=30
SYNC_BACKFILL_MESSAGES=20
SYNC_BACKFILL_MEDIA_DIALOGS=10
SYNC_DISCOVERY_DIALOGS=500
MEDIA_MAX_MB=25

# --- Security ---
# 32-byte key (64 hex chars) used to encrypt stored login sessions at rest.
# Generate with:  openssl rand -hex 32
# REQUIRED in production (the app refuses to start without it when NODE_ENV=production).
APP_ENCRYPTION_KEY=

# --- Git updates ---
# Every installation checks its configured Git remote for new commits. Private
# repo access stays in that machine's Git credentials (GitHub CLI, SSH key, or
# credential helper). One-click updates are enabled automatically on localhost;
# set this to 0 to disable them, or 1 to allow them on a supervised deployment.
ALLOW_SELF_UPDATE=
UPDATE_GIT_REMOTE=origin
UPDATE_GIT_BRANCH=master
# Production/launchd/pm2 only: command that restarts the app after an update.
# UPDATE_RESTART_CMD=pm2 restart omnicrm

# --- Hosting (Railway / Docker) ---
# Where to persist DB + login sessions (Railway: mount a volume at /data).
# DATA_DIR=/data
# DATABASE_URL="file:/data/dev.db"
# Route the WhatsApp + X browsers through a sticky RESIDENTIAL proxy that is
# geo-matched to where the account normally logs in. Leave empty for direct.
# PROXY_URL=http://user:pass@host:port
# Use the system Chromium in Docker (set by the Dockerfile).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# --- Social listening (the standalone X listener) ---
# Shared secret the listener must present on /api/listening/ingest.
# Must equal DASHBOARD_INGEST_SECRET in the listener's .env.
# Unset = the ingest endpoint rejects everything.
LISTENING_INGEST_SECRET=""
# Base URL of the listener's config API — powers the Watchers panel and
# relays 👍/👎 back so the LLM keeps learning.
LISTENING_URL="http://localhost:3001"
# The listener's CONFIG_API_KEY, if it has one set.
LISTENING_CONFIG_KEY=""
# Days to keep leads you never acted on (contacted or rated ones are kept).
LISTENING_RETENTION_DAYS="180"
# Public replies posted from the Listening tab (cookie session, not the official API).
X_REPLY_DAILY_CAP="15"
# Only needed if v1.1 statuses/update stops working — grab from DevTools → Network
# on a real reply, the CreateTweet request URL contains it.
X_CREATE_TWEET_QUERY_ID=""
